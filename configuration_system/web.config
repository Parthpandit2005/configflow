<?xml version="1.0" encoding="utf-8"?>

<configuration>

    <system.webServer>

        <handlers>
            <add
                name="Python"
                path="*"
                verb="*"
                modules="httpPlatformHandler"
                resourceType="Unspecified"
            />
        </handlers>

        <httpPlatform
            processPath="C:\PythonApps\ConfigurationSystem\venv\Scripts\python.exe"
            arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% --url-prefix=/ConfigurationSystem app:app"
            stdoutLogEnabled="true"
            stdoutLogFile="C:\inetpub\wwwroot\ConfigurationSystem\logs\python.log"
            startupTimeLimit="60"
            >

            <environmentVariables>

                <environmentVariable
                    name="PYTHONPATH"
                    value="C:\inetpub\wwwroot\ConfigurationSystem"
                />

            </environmentVariables>

        </httpPlatform>

    </system.webServer>

</configuration>